[Unit]
Description=Rivian Gear Shop Crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/rivian-gearshop-crawler
ExecStart=/opt/rivian-gearshop-crawler/venv/bin/python3 /opt/rivian-gearshop-crawler/crawler.py
Environment=PATH=/opt/rivian-gearshop-crawler/venv/bin:/usr/bin:/bin
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

# --- Sandboxing ---------------------------------------------------------
# This unit drives headless Chromium over untrusted remote pages, so it gets
# the strictest confinement that still lets it work. It stays User=root
# because /opt/rivian-gearshop-crawler is root-owned; see README ("Running the
# crawlers as a non-root user") for moving off root, which is the bigger win.
NoNewPrivileges=true
PrivateTmp=true
# read-only, NOT `true`: Playwright installs Chromium under
# /root/.cache/ms-playwright, and `ProtectHome=true` would hide it and break
# every browser launch. read-only keeps the binary reachable while denying
# writes. (Chromium's own profile goes to the private /tmp above.)
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/opt/rivian-gearshop-crawler
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
