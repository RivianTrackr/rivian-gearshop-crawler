[Unit]
Description=Rivian Gearshop Admin UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rivian-gearshop-crawler
# --proxy-headers + --forwarded-allow-ips makes request.client.host the real
# client address from nginx's X-Forwarded-For instead of 127.0.0.1. Without it
# every login attempt shares a single rate-limit bucket, so five failures from
# anyone lock out everybody.
ExecStart=/opt/rivian-gearshop-crawler/venv/bin/uvicorn admin.app:app \
    --host 127.0.0.1 --port 8111 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Environment=PATH=/opt/rivian-gearshop-crawler/venv/bin:/usr/bin:/bin
Restart=always
RestartSec=5
# Deliberately NOT sandboxed: this unit installs unit files into
# /etc/systemd/system and shells out to systemctl for the Deploy page.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
